#!/bin/sh
# Каждую минуту: если WDTT включён и wg up — починить datapath (selective или full).
# Cron: * * * * * /usr/libexec/wdtt/keepalive

enabled="$(uci -q get wdtt.globals.enabled 2>/dev/null)"
[ "$enabled" = "1" ] || exit 0

IFACE="$(uci -q get wdtt.globals.iface 2>/dev/null)"
IFACE="${IFACE:-wg-wdtt}"

ip link show "$IFACE" >/dev/null 2>&1 || exit 0

if [ -x /usr/libexec/wdtt/datapath ]; then
	/usr/libexec/wdtt/datapath ensure "$IFACE" >/dev/null 2>&1
	exit $?
fi

# fallback без datapath (старые образы)
MARK=0x777474
TABLE=100
mode="$(uci -q get wdtt.globals.routing_mode 2>/dev/null)"
[ "$(uci -q get wdtt.globals.full_tunnel 2>/dev/null)" = "1" ] && mode="full"

if [ "$mode" = "full" ]; then
	[ -x /usr/libexec/wdtt/full-tunnel ] && /usr/libexec/wdtt/full-tunnel apply >/dev/null 2>&1
	exit 0
fi

[ -x /usr/libexec/wdtt/routing ] || exit 0
if [ ! -f /var/run/wdtt/routing.mode ] || ! nft list table inet wdtt >/dev/null 2>&1; then
	/usr/libexec/wdtt/routing start "$IFACE" >/dev/null 2>&1 \
		|| /usr/libexec/wdtt/routing restore "$IFACE" >/dev/null 2>&1
fi
if ! ip route show table "$TABLE" 2>/dev/null | grep -q .; then
	ip route replace default dev "$IFACE" table "$TABLE" 2>/dev/null
fi
if ! ip rule show | grep -q "fwmark $MARK"; then
	ip rule add fwmark "$MARK" table "$TABLE" priority 10050 2>/dev/null
fi
exit 0
