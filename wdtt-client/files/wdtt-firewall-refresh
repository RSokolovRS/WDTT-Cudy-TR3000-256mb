#!/bin/sh
# После поднятия wg-wdtt (вне netifd): зона fw4, NAT, forward, ip_forward.
# Нужен и для selective, и для full — иначе LAN-трафик не уходит в туннель.

IFACE="$(uci -q get wdtt.globals.iface 2>/dev/null)"
IFACE="${IFACE:-wg-wdtt}"
[ -n "$1" ] && [ "$1" != "apply" ] && IFACE="$1"

log() { logger -t wdtt-firewall "$*"; }

ensure_network_iface() {
	if ! uci -q get network.wdtt >/dev/null 2>&1; then
		uci -q batch <<-EOF
			set network.wdtt=interface
			set network.wdtt.proto='none'
			set network.wdtt.device='$IFACE'
			commit network
		EOF
		log "created network.wdtt device=$IFACE"
	else
		uci -q set network.wdtt.device="$IFACE"
		uci -q commit network
	fi
}

ensure_firewall_zone() {
	if ! uci -q get firewall.wdtt >/dev/null 2>&1; then
		uci -q batch <<-EOF
			set firewall.wdtt=zone
			set firewall.wdtt.name='wdtt'
			set firewall.wdtt.input='ACCEPT'
			set firewall.wdtt.output='ACCEPT'
			set firewall.wdtt.forward='ACCEPT'
			set firewall.wdtt.masq='1'
			set firewall.wdtt.mtu_fix='1'
			add_list firewall.wdtt.network='wdtt'
			commit firewall
		EOF
		log "created firewall zone wdtt"
	else
		uci -q set firewall.wdtt.masq='1'
		uci -q set firewall.wdtt.mtu_fix='1'
		uci -q commit firewall
	fi

	if ! uci -q get firewall.wdtt_lan_fwd >/dev/null 2>&1; then
		uci -q batch <<-EOF
			set firewall.wdtt_lan_fwd=forwarding
			set firewall.wdtt_lan_fwd.src='lan'
			set firewall.wdtt_lan_fwd.dest='wdtt'
			commit firewall
		EOF
		log "created lan→wdtt forwarding"
	fi
}

bring_up_iface() {
	if command -v ifup >/dev/null 2>&1; then
		ifup wdtt 2>/dev/null || true
	fi
	ubus call network reload 2>/dev/null || true
	ubus call network.interface.wdtt up 2>/dev/null || true
}

has_masq() {
	nft list chain inet fw4 srcnat 2>/dev/null | grep -q "oifname \"$IFACE\""
}

apply_masq() {
	[ -x /etc/firewall.wdtt ] && /etc/firewall.wdtt
	has_masq && return 0
	# Зона могла не подхватить device — перезагрузка fw4
	if command -v fw4 >/dev/null 2>&1; then
		fw4 reload 2>/dev/null || /etc/init.d/firewall reload 2>/dev/null
	else
		/etc/init.d/firewall reload 2>/dev/null
	fi
	sleep 1
	[ -x /etc/firewall.wdtt ] && /etc/firewall.wdtt
	has_masq
}

sysctl_tune() {
	sysctl -qw net.ipv4.ip_forward=1 2>/dev/null
	sysctl -qw net.ipv4.conf.all.forwarding=1 2>/dev/null
	sysctl -qw net.ipv4.conf.default.forwarding=1 2>/dev/null
	# loose rp_filter — иначе return path через wg-wdtt дропается
	sysctl -qw net.ipv4.conf.all.rp_filter=2 2>/dev/null
	sysctl -qw net.ipv4.conf.default.rp_filter=2 2>/dev/null
	sysctl -qw "net.ipv4.conf.${IFACE}.rp_filter=2" 2>/dev/null
}

case "${1:-apply}" in
	apply|"$IFACE"|*)
		if ! ip link show "$IFACE" >/dev/null 2>&1; then
			log "WARN: $IFACE down — skip firewall refresh"
			exit 1
		fi
		ensure_network_iface
		ensure_firewall_zone
		bring_up_iface
		sysctl_tune
		if apply_masq; then
			log "OK: firewall ready for $IFACE (masq+forward)"
			exit 0
		fi
		log "WARN: masquerade for $IFACE still missing"
		exit 1
		;;
esac
